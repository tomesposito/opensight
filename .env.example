# OpenSight local hosted-mode development credentials. DO NOT COMMIT.
# Copy to `.env` and fill in, or just run `npm run dev:hosted` to generate one.
# `.env` is gitignored. Delete it to regenerate fresh keys.

OPENSIGHT_PUBLIC_ORIGIN=http://localhost:3001
OPENSIGHT_AUTH_ISSUER=opensight-dev
OPENSIGHT_AUTH_AUDIENCE=opensight-dev-api
OPENSIGHT_AUTH_KEY_ID=dev-key
# 32 random bytes, base64, pairwise distinct (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
OPENSIGHT_AUTH_SIGNING_KEY=
OPENSIGHT_AUTH_ENCRYPTION_KEY=
OPENSIGHT_OPERATOR_KEY=
OPENSIGHT_SESSION_SECONDS=3600
OPENSIGHT_INVITATION_SECONDS=86400
OPENSIGHT_METADATA_DATABASE=.opensight/dev-hosted.sqlite
# Budget envelopes (JSON). Dev defaults mirror the test fixtures.
OPENSIGHT_NODE_LIMITS=
OPENSIGHT_TENANT_LIMIT_DEFAULTS=
OPENSIGHT_TENANT_LIMIT_OVERRIDES={}
OPENSIGHT_DEV_EMAIL=dev@opensight.local
OPENSIGHT_DEV_PASSWORD=
OPENSIGHT_DEV_NAME=Dev Admin
OPENSIGHT_DEV_TENANT=Dev tenant
