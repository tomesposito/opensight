{
  "dataSetIdentifierDeclarations": [
    {
      "identifier": "sales_data",
      "dataSetArn": "arn:aws:quicksight:us-east-1:123456789012:dataset/renderable-sales"
    }
  ],
  "calculatedFields": [
    {
      "DataSetIdentifier": "sales_data",
      "Name": "discounted_revenue",
      "Expression": "{revenue} * 0.9"
    }
  ],
  "filterGroups": [
    {
      "FilterGroupId": "east-only",
      "CrossDataset": "SINGLE_DATASET",
      "Status": "ENABLED",
      "ScopeConfiguration": {
        "AllSheets": {}
      },
      "Filters": [
        {
          "CategoryFilter": {
            "FilterId": "east-region",
            "Column": {
              "DataSetIdentifier": "sales_data",
              "ColumnName": "region"
            },
            "Configuration": {
              "FilterListConfiguration": {
                "MatchOperator": "EQUALS",
                "CategoryValues": [
                  "East"
                ],
                "NullOption": "NON_NULLS_ONLY"
              }
            }
          }
        }
      ]
    }
  ],
  "sheets": [
    {
      "sheetId": "overview",
      "name": "Overview",
      "contentType": "INTERACTIVE",
      "visuals": [
        {
          "barChartVisual": {
            "visualId": "revenue-by-region",
            "title": {
              "visibility": "VISIBLE",
              "formatText": {
                "plainText": "Revenue by Region"
              }
            },
            "chartConfiguration": {
              "fieldWells": {
                "barChartAggregatedFieldWells": {
                  "category": [
                    {
                      "categoricalDimensionField": {
                        "fieldId": "region",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "region"
                        }
                      }
                    }
                  ],
                  "values": [
                    {
                      "numericalMeasureField": {
                        "fieldId": "revenue",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "revenue"
                        },
                        "aggregationFunction": {
                          "simpleNumericalAggregation": "SUM"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "lineChartVisual": {
            "visualId": "revenue-trend",
            "title": {
              "visibility": "VISIBLE",
              "formatText": {
                "plainText": "Monthly Revenue"
              }
            },
            "chartConfiguration": {
              "fieldWells": {
                "lineChartAggregatedFieldWells": {
                  "category": [
                    {
                      "dateDimensionField": {
                        "fieldId": "order_date",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "order_date"
                        },
                        "dateGranularity": "MONTH"
                      }
                    }
                  ],
                  "values": [
                    {
                      "numericalMeasureField": {
                        "fieldId": "revenue",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "revenue"
                        },
                        "aggregationFunction": {
                          "simpleNumericalAggregation": "SUM"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "tableVisual": {
            "visualId": "sales-table",
            "title": {
              "visibility": "VISIBLE",
              "formatText": {
                "plainText": "Revenue and Discounted Revenue"
              }
            },
            "chartConfiguration": {
              "fieldWells": {
                "tableAggregatedFieldWells": {
                  "groupBy": [
                    {
                      "categoricalDimensionField": {
                        "fieldId": "region",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "region"
                        }
                      }
                    }
                  ],
                  "values": [
                    {
                      "numericalMeasureField": {
                        "fieldId": "revenue",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "revenue"
                        },
                        "aggregationFunction": {
                          "simpleNumericalAggregation": "SUM"
                        }
                      }
                    },
                    {
                      "numericalMeasureField": {
                        "fieldId": "discounted_revenue",
                        "column": {
                          "dataSetIdentifier": "sales_data",
                          "columnName": "discounted_revenue"
                        },
                        "aggregationFunction": {
                          "simpleNumericalAggregation": "SUM"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        {
