{
  "name": "@opensight/mcp-server",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Stdio MCP tools generated from the OpenSight v1 HTTP contract",
  "bin": {
    "opensight-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsc && node scripts/build.mjs",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test --test-isolation=none test/*.test.mjs"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.3",
    "esbuild": "0.25.12",
    "js-yaml": "4.1.1",
    "typescript": "^5.6.0"
  }
}
