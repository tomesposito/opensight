{
  "name": "@opensight/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace @opensight/reports && npm run build --workspace=@opensight/bundle-parser && npm run build --workspace=@opensight/query-engine && npm run build --workspace=@opensight/o-interpreter && npm run build:compiler --workspace=@opensight/web && tsc && npm run build:embed --workspace=@opensight/web",
    "start": "node dist/cli.js",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test --test-isolation=none test/*.test.mjs",
    "metadata:migrate": "node dist/metadata-migrate-cli.js",
    "sources:migrate": "node dist/source-migrate-cli.js",
    "budgets:migrate": "node dist/budget-migrate-cli.js",
    "jobs:migrate": "node dist/job-migrate-cli.js",
    "reference": "node dist/single-node-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata-entry.d.ts",
      "import": "./dist/metadata-entry.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@opensight/bundle-parser": "0.0.0",
    "@opensight/o-interpreter": "0.0.0",
    "@opensight/query-engine": "0.0.0",
    "@opensight/web": "0.0.0",
    "pg": "^8.23.0",
    "@opensight/reports": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "fflate": "0.8.3",
    "typescript": "^5.6.0",
    "@types/pg": "^8.23.1"
  }
}
