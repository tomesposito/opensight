{
  "name": "@opensight/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=@opensight/bundle-parser && npm run build --workspace=@opensight/query-engine && npm run build --workspace=@opensight/o-interpreter && npm run build:compiler --workspace=@opensight/web && tsc && npm run build:embed --workspace=@opensight/web",
    "start": "node dist/cli.js",
    "start:runtime": "node dist/runtime-cli.js",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test --test-isolation=none test/*.test.mjs",
    "metadata:migrate": "node dist/metadata-migrate-cli.js",
    "sources:migrate": "node dist/source-migrate-cli.js",
    "budgets:migrate": "node dist/budget-migrate-cli.js",
    "jobs:migrate": "node dist/job-migrate-cli.js",
    "reference": "node dist/single-node-cli.js",
    "storage:inspect": "node dist/storage-inspect-cli.js",
    "storage:recover": "node dist/storage-recover-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./lambda": {
      "types": "./dist/lambda.d.ts",
      "import": "./dist/lambda.js"
    },
    "./scheduler-lambda": {
      "types": "./dist/scheduler-lambda.d.ts",
      "import": "./dist/scheduler-lambda.js"
    },
    "./migration-lambda": {
      "types": "./dist/migration-lambda.d.ts",
      "import": "./dist/migration-lambda.js"
    },
    "./metadata": {
      "types": "./dist/metadata-entry.d.ts",
      "import": "./dist/metadata-entry.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-scheduler": "3.1149.0",
    "@aws-sdk/client-secrets-manager": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@opensight/bundle-parser": "0.0.0",
    "@opensight/o-interpreter": "0.0.0",
    "@opensight/query-engine": "0.0.0",
    "@opensight/web": "0.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "fflate": "0.8.3",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^5.6.0"
  }
}
